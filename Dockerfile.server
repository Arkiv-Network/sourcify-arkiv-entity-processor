# Separate read-only API image. Offline ingestion remains in the root Dockerfile.
FROM rust:1.90.0-slim-trixie AS builder
WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY crates/server ./crates/server
RUN cargo build -p arkiv-sourcify-server --release --locked

FROM debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates locales && localedef -i en_US -f UTF-8 en_US.UTF-8 && rm -rf /var/lib/apt/lists/*
COPY --from=builder /build/target/release/arkiv-sourcify-server /usr/local/bin/arkiv-sourcify-server
COPY --from=builder /build/crates/server/src/proxy-whatsabi-LICENSE.txt /usr/share/licenses/arkiv-sourcify-server/whatsabi-LICENSE.txt
COPY --from=builder /build/crates/server/tests/fixtures/proxy/SOURCIFY-LICENSE /usr/share/licenses/arkiv-sourcify-server/SOURCIFY-LICENSE
USER 65532:65532
EXPOSE 3000
ENTRYPOINT ["arkiv-sourcify-server"]
