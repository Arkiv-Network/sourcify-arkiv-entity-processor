# Copy to .env and edit. Relative paths are relative to this directory.

# prepare: the Sourcify PostgreSQL database (read-only; a role with SELECT on its tables, see README.md), reached on
# the Docker network SOURCE_NETWORK. The password is in the libpq password file PG_PASSFILE
# (host:port:database:user:password, mode 600, readable by PIPELINE_UID; never commit it).
SOURCE_NETWORK=sourcify-node_default
PGHOST=db
PGPORT=5432
PGDATABASE=sourcify
PGUSER=sourcify_export
PG_SCHEMA=public
PG_PASSFILE=./pgpass
# Work directory, writable by PIPELINE_UID: prepared DuckDB, bundle, archive, logs and timings.json.
# A full Ethereum run needs ~150 GB (source) + ~210 GB (bundle) + ~39 GB (prefill archive, publish only).
WORK_DIR=./data/work

# Public owner/creator address written to every entity. Seed metadata, not a key or signing account.
ENTITY_OWNER=0x0000000000000000000000000000000000000001
# Destination Arkiv chain ID written to seed.json.
DESTINATION_CHAIN_ID=7706815

# Container user and limits.
PIPELINE_UID=1000
PIPELINE_GID=1000
PIPELINE_CPUS=12
PIPELINE_MEMORY=48g

# prepare: PostgreSQL -> DuckDB.
PREPARE_THREADS=8
PREPARE_MEMORY_LIMIT=24GB
# Empty: all current Ethereum matches. N (1..100000): only the first N by match ID, for trial runs.
PREPARE_LIMIT=

# process: DuckDB -> NDJSON -> arkiv-entity-processor.
SOURCE_BATCH_SIZE=250
SOURCE_MEMORY_LIMIT=6GB
# Empty: every prepared match. N: stop after N records.
CONTRACT_LIMIT=
# 1: skip (and list in report.json) records whose referenced rows are missing from the export.
SKIP_MISSING_REFERENCES=1
MAX_SKIPPED=100000
PROCESS_WORKERS=4
COMPRESSION_WORKERS=4
PROGRESS_INTERVAL=60

# publish: pack the bundle into WORK_DIR/archive/seed.tar.zst and upload it to R2.
# prefill: seed.json, entity parts, report.json and a SHA256SUMS of just those (what arkiv-prefill
# loads). full: also the audit files payloads.bin and metadata.jsonl (~130 GB more for Ethereum).
PACK_CONTENTS=prefill
R2_BUCKET=arkiv-sourcify-preload
R2_KEY=seed-inputs/sourcify-ethereum-never.tar.zst
# File with AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_ENDPOINT_URL_S3 (https://<account>.r2.cloudflarestorage.com).
R2_CREDENTIALS_FILE=./r2.env
ZSTD_LEVEL=3
PACK_THREADS=8
UPLOAD_CONCURRENCY=8
UPLOAD_PART_SIZE_MIB=64
