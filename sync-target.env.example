# One Postgres -> Arkiv sync target: copy to targets/NAME.env (NAME: lowercase letters, digits, dashes) and run
# `pipeline/sync-targets.sh up NAME`. These settings win over .env, which holds what all targets share.

# The chain. The sync refuses an RPC that reports another chain ID; one target per chain.
ARKIV_RPC_URL=https://sourcify-prefill.arkiv-global.net/rpc
ARKIV_CHAIN_ID=7706815

# Optional: another writer key file than .env's ARKIV_WRITER_KEY_FILE. Its address must be ENTITY_OWNER.
#ARKIV_WRITER_KEY_FILE=./arkiv-writer.key

# Optional: batch size, polling, gas, unmined transactions at a time (1..16) and container limits.
#SYNC_BATCH=200
#SYNC_POLL_SECONDS=60
#SYNC_MAX_GAS_PRICE_GWEI=2
#SYNC_IN_FLIGHT=4
# Calldata per transaction (at least 4000). A chain that cannot take large transactions gets less, e.g. 16000 with
# SYNC_IN_FLIGHT=1. An entity larger than this still travels alone: payloads are up to 122,880 bytes (seed format).
#SYNC_MAX_TX_BYTES=120000
# Seconds of pause after each batch that sent transactions (0..3600); with SYNC_BATCH=1, between contracts.
#SYNC_BATCH_DELAY_SECONDS=0
#SYNC_CPUS=1
#SYNC_MEMORY=2g
